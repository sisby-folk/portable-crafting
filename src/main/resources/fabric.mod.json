{
	"schemaVersion": 1,
	"id": "${modId}",
	"version": "${version}",
	"name": "${modName}",
	"description": "${modDescription}",
	"authors": [
		"${authors}"
	],
	"contact": {
		"homepage": "${homepage}",
		"issues": "${issues}",
		"sources": "${sources}"
	},
	"license": "${license}",
	"icon": "assets/${modId}/icon.png",
	"entrypoints": {
		"main": [
			"folk.sisby.portable_crafting.PortableCrafting"
		],
		"client": [
			"folk.sisby.portable_crafting.PortableCraftingClient"
		]
	},
	"depends": {
		"fabricloader": ">=${fl}",
		"minecraft": ">=${mc}",
		"fabric-api": ">=${fapi}"
	},
	"suggests": {
		"inventory-tabs": ">=${tabs}"
	},
	"breaks": {
		"inventory-tabs": "<${tabs}"
	},
	"mixins": [
		"${modId}.mixins.json"
	]
}
